// TaskForge — Prisma schema
//
// Authoritative store: PostgreSQL. Schema management: Prisma migrations.
//
// SCOPE — this covers the approved initial product milestone only. Deliberately
// ABSENT because they are deferred product decisions, not oversights:
//   - workspace invitations / join      (Coming Soon, resolved D-10)
//   - role-based permissions            (deferred, resolved D-03 — `role` on
//                                       Membership is informational only and
//                                       grants nothing)
//   - configurable automation, external integrations, historical analytics,
//     exports, permanent deletion       (out of scope for the initial milestone)
//
// Docs: docs/01_PRODUCT_REQUIREMENTS.md sections 5.1-5.11, 8, 11.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // The connection URL is NOT declared here. Prisma 7 requires the migrate-time
  // URL in prisma.config.ts and a driver adapter on the PrismaClient
  // constructor at runtime.
}

// --- Identity and sessions ------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Stored lowercased. Uniqueness is enforced (FR-AUTH-003).
  email        String   @unique
  displayName  String
  /// argon2id PHC string. The plaintext password is never stored, logged, or
  /// rendered (NFR-SEC-005, AGENTS.md 11.3).
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces Workspace[]     @relation("WorkspaceOwner")
  memberships     Membership[]
  sessions        Session[]
  comments        Comment[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  notifications   Notification[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  /// SHA-256 of the opaque session token. The raw token exists only in the
  /// client's HttpOnly cookie, so a database leak does not yield usable sessions.
  tokenHash String    @unique
  /// Double-submit CSRF token. Required because the session is cookie-based.
  csrfToken String
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// --- Workspaces -----------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @db.Uuid
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]

  @@index([ownerId])
}

/// Membership is the authorisation fact. NFR-SEC-010: every read and every
/// write verifies membership at the time of the request, server-side.
model Membership {
  userId      String         @db.Uuid
  workspaceId String         @db.Uuid
  /// Informational only. No permission matrix is derived from this — role-based
  /// permissions are deferred (resolved D-03). Deferring roles does NOT relax
  /// membership scoping.
  role        MembershipRole @default(OWNER)
  createdAt   DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

enum MembershipRole {
  OWNER
  MEMBER
}

// --- Projects -------------------------------------------------------------

enum ProjectState {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  /// One of the approved 8 brand/accent swatches. Never purple or lavender
  /// (design-system 6.17). Stored as a token name, not a hex literal, so the
  /// palette stays owned by the design system.
  colourToken String?
  state       ProjectState @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tasks         Task[]
  notifications Notification[]

  @@index([workspaceId, state])
  @@index([workspaceId, createdAt])
}

// --- Tasks ----------------------------------------------------------------

/// Fixed, terminal at Done. Not user-extensible (resolved D-09).
enum TaskStage {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
  NONE
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String       @default("")
  stage       TaskStage    @default(BACKLOG)
  priority    TaskPriority @default(NONE)
  assigneeId  String?      @db.Uuid
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  comments Comment[]

  // Board groups by stage and orders newest-first within a column (resolved
  // D-09: no manual reordering).
  @@index([projectId, stage, createdAt])
  @@index([projectId, createdAt])
  @@index([assigneeId])
}

// --- Comments -------------------------------------------------------------

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

// --- In-app notifications -------------------------------------------------

enum NotificationKind {
  TASK_COMMENTED
  TASK_ASSIGNED
  TASK_STAGE_CHANGED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
}

/// In-app only. Delivery channels beyond the app are an open decision (D-04) and
/// are therefore not implemented.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?          @db.Uuid
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}
