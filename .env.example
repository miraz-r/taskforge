# TaskForge — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed
# (AGENTS.md 11.4). Never paste a real credential into this file.
#
#   cp .env.example .env

# --- required -------------------------------------------------------------

# --- database -------------------------------------------------------------
#
# TWO ROLES, TWO URLS. Keeping them separate means a compromised application
# process cannot alter the database schema. See docs/setup.md for how to create
# both roles and the least-privilege grants.
#
# Runtime credential. Data privileges only (SELECT/INSERT/UPDATE); no CREATE on
# the schema, no CREATE on the database. There is no in-memory fallback: the API
# refuses to start without this.
DATABASE_URL="postgresql://taskforge_app:CHANGE_ME@127.0.0.1:5432/taskforge?schema=public"

# Migration credential, used only by the Prisma CLI (`npm run prisma:*`). This
# role owns the schema so it can create and alter objects, and needs CREATEDB for
# the shadow database that `prisma migrate dev` provisions. Never used by the
# running application.
MIGRATION_DATABASE_URL="postgresql://taskforge_migrate:CHANGE_ME@127.0.0.1:5432/taskforge?schema=public"

# --- server ----------------------------------------------------------------

NODE_ENV="development"
PORT=4000
HOST="127.0.0.1"

# Origin the browser app is served from. Used for cookie `secure` and for
# rejecting cross-site state-changing requests.
APP_ORIGIN="http://localhost:5173"

SESSION_COOKIE_NAME="taskforge_session"
SESSION_TTL_HOURS=168

# Cookies are marked Secure unless this is false. Disable ONLY for local http
# development — a production deployment with this false exposes its session
# cookie on the wire.
COOKIE_SECURE="false"

# Trust X-Forwarded-For. Enable only behind a proxy you control, because rate
# limiting keys on the client IP.
TRUST_PROXY="false"

# --- rate limiting ---------------------------------------------------------

# Fixed-window limit for /api/auth/register, /sign-in and /migrate/legacy.
# Only FAILED attempts count, so a correct user is never locked out.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000

# --- product limits --------------------------------------------------------

# Maximum workspaces a single user may own.
MAX_WORKSPACES_PER_USER=2

# --- client (optional) -----------------------------------------------------

# Where `npm run dev` proxies /api. Defaults to http://127.0.0.1:4000.
# API_ORIGIN="http://127.0.0.1:4000"
